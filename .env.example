# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_SECRET: Server-side secret passcode for accessing the hidden /admin analytics dashboard.
# Never expose this value in client-side code. If left empty, a one-time setup form on /admin
# lets the operator claim an initial scrypt-hashed password.
ADMIN_SECRET=

# ANALYTICS_ENABLED: Set to "false" to disable the optional aggregate analytics endpoint.
ANALYTICS_ENABLED="true"
